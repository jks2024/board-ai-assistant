# 복사해서 .env 로 만든 뒤 값을 채웁니다:  cp .env.example .env   (따옴표 없이)

# Spring(backend/.env)의 SERVICE_TOKEN 과 반드시 같은 값
SERVICE_TOKEN=

# stub  : OpenAI 키·Atlas 없이 동작 (2-gram 겹침 점수, 메모리 저장 → 재시작하면 사라짐)
# atlas : OpenAI 임베딩 + MongoDB Atlas Vector Search
RAG_ENGINE=stub

# ── 검색·그래프 설정 ──
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
# 근거로 인정할 최소 점수 (atlas: 0~1 로 바뀐 코사인 유사도 / stub: 2-gram 겹침 비율)
MIN_SCORE=0.70
STUB_MIN_SCORE=0.30
# 근거가 없을 때 질문을 바꿔 다시 찾는 최대 횟수
MAX_REWRITES=1

# ── atlas 엔진일 때만 ──
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MONGODB_URI=
MONGODB_DB=rag
MONGODB_COLLECTION=board_chunks
ATLAS_INDEX_NAME=board_vector_index
