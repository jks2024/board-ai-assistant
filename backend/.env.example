# 복사해서 .env 로 만든 뒤 값을 채웁니다:  cp .env.example .env
# 값에는 따옴표를 쓰지 않습니다.

# MySQL 비밀번호 (DB board_ai 는 처음 실행할 때 자동 생성)
MYSQL_PASSWORD=

# JWT 서명 키 (Base64, 64바이트 이상) - 생성: openssl rand -base64 64
JWT_SECRET=

# AI 서비스(FastAPI)와 같은 값 - 생성: openssl rand -hex 32
SERVICE_TOKEN=

# 관리자 이메일 (이 이메일로 가입하면 ROLE_ADMIN)
ADMIN_EMAILS=admin@test.com

# (선택) 카카오 개발자 콘솔 > [앱] > [플랫폼 키] > [REST API 키] / [클라이언트 시크릿]
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
